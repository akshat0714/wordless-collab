NODE_ENV=production
PRODUCT_MODE=customer_clarify
GATEWAY_HOST=0.0.0.0
PORT=8080

GATEWAY_STORE=postgres
DATABASE_URL_FILE=/run/secrets/database_url
INSTALLATIONS_JSON_FILE=/run/config/installations.json

WORDLESS_BASE_URL=https://api.example-wordless.com
EVIDENCE_RESOLVER_MODE=http
EVIDENCE_RESOLVER_URL=https://evidence.example.com/v1/resolve
EVIDENCE_RESOLVER_SECRET_REF=EVIDENCE_RESOLVER_HMAC_SECRET

OUTBOX_DELIVERY_MODE=zendesk
CHOICE_TTL_HOURS=1
SUPPORTED_LOCALE_PREFIXES=en
REQUIRE_KNOWN_LOCALE=true
BODY_MAX_BYTES=262144
WEBHOOK_CLOCK_SKEW_SECONDS=300
WEBHOOK_PROCESS_TIMEOUT_MS=25000
ZENDESK_TIMEOUT_MS=10000
OUTBOX_POLL_MS=500
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=10
RETENTION_DAYS=30

# Every secret reference named in installations.json resolves from either REF or REF_FILE.
ZENDESK_WEBHOOK_SECRET_FILE=/run/secrets/zendesk_webhook_secret
CHOICE_SIGNING_SECRET_FILE=/run/secrets/choice_signing_secret
WORDLESS_API_KEY_FILE=/run/secrets/wordless_api_key
WORDLESS_SIGNING_SECRET_FILE=/run/secrets/wordless_signing_secret
ZENDESK_KEY_ID_FILE=/run/secrets/zendesk_key_id
ZENDESK_KEY_SECRET_FILE=/run/secrets/zendesk_key_secret
EVIDENCE_RESOLVER_HMAC_SECRET_FILE=/run/secrets/evidence_resolver_hmac_secret
