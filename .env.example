# Verified by the Module 0 benchmark. Core services do not assume this default.
WORDLESS_EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
WORDLESS_EMBED_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
WORDLESS_OFFLINE=true
WORDLESS_CACHE_DIR=.wordless/cache
WORDLESS_SEED=17

# LLM settings are optional. If used, provider and model must be configured
# together and the application must supply a provider adapter at startup.
# WORDLESS_LLM_PROVIDER=
# WORDLESS_LLM_MODEL_ID=
WORDLESS_LLM_TIMEOUT_SECONDS=30
WORDLESS_LLM_MAX_RETRIES=2

# Single-node real-time pilot. The local launcher forces development mode and
# accepts loopback traffic only. These values are reference configuration; the
# repository does not automatically load .env files.
WORDLESS_REALTIME_DEV_MODE=true
WORDLESS_REALTIME_WORKSPACE=.
WORDLESS_REALTIME_DATABASE_PATH=.wordless/realtime.sqlite3
WORDLESS_REALTIME_MODEL_CACHE_DIR=.wordless/cache/embeddings
WORDLESS_REALTIME_OFFLINE=false
WORDLESS_REALTIME_EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
WORDLESS_REALTIME_EMBED_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
WORDLESS_REALTIME_EMBED_BATCH_SIZE=32
WORDLESS_REALTIME_SEED=17
# Illustrative local-demo floor only; it is not customer calibration evidence.
WORDLESS_REALTIME_THRESHOLD=1.5
WORDLESS_REALTIME_THRESHOLD_VERSION=demo-floor-v1
WORDLESS_REALTIME_RATE_LIMIT_PER_MINUTE=120
WORDLESS_REALTIME_MAX_INFERENCE_CONCURRENCY=4
WORDLESS_REALTIME_SIGNATURE_TOLERANCE_SECONDS=300
WORDLESS_REALTIME_MAX_FUTURE_OBSERVED_SECONDS=300

# Development mode auto-provisions public local-only credentials and disables
# signature enforcement. The example client still signs POSTs. In non-dev mode,
# inject WORDLESS_REALTIME_TENANTS_JSON and WORDLESS_REALTIME_API_KEY_PEPPER from
# a secret manager; do not commit either value.
# WORDLESS_REALTIME_TENANTS_JSON=
# WORDLESS_REALTIME_API_KEY_PEPPER=
# Production orchestrators may mount either secret as a UTF-8 file instead.
# Configure the value or the matching _FILE variable, never both.
# WORDLESS_REALTIME_TENANTS_JSON_FILE=/run/secrets/wordless_tenants_json
# WORDLESS_REALTIME_API_KEY_PEPPER_FILE=/run/secrets/wordless_api_key_pepper

# Optional example-client origin.
# WORDLESS_REALTIME_BASE_URL=http://127.0.0.1:8001

# Server-only settings for the local, loopback-only console /live proxy. The
# console is not deployed or human-authenticated. Never use NEXT_PUBLIC_ names
# for credentials; browser code must not receive these values.
# WORDLESS_REALTIME_API_BASE_URL=http://127.0.0.1:8001
# WORDLESS_REALTIME_API_KEY=
# WORDLESS_REALTIME_SIGNING_SECRET=
