{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@wordless/sdk/server": ["./src/server.ts"],
      "@wordless/sdk/zendesk": ["./src/zendesk.ts"],
      "@wordless/sdk/zendesk-marketplace": ["./src/zendesk-marketplace.ts"]
    },
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "examples", "vitest.config.ts"]
}
