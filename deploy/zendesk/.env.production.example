# Generated .env.production values are non-secret. Run bootstrap.py instead of
# copying this file for a real pilot.
COMPOSE_PROJECT_NAME=wordless-zendesk
PUBLIC_DOMAIN=wordless-sandbox.example.com
EVIDENCE_RESOLVER_URL=https://support-api.example.com/wordless/evidence

# These must come from the customer's labeled sandbox evaluation.
WORDLESS_THRESHOLD=1.6
WORDLESS_THRESHOLD_VERSION=customer-sandbox-eval-2026-07-30

# Exact model revision used by the repository benchmark and production checks.
WORDLESS_EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
WORDLESS_EMBED_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
WORDLESS_OFFLINE=false
WORDLESS_RATE_LIMIT_PER_MINUTE=120
WORDLESS_MAX_INFERENCE_CONCURRENCY=4
SUPPORTED_LOCALE_PREFIXES=en
REQUIRE_KNOWN_LOCALE=true

CHOICE_TTL_HOURS=1
RETENTION_DAYS=30

CADDY_IMAGE=caddy:2.11.4-alpine
POSTGRES_IMAGE=postgres:17.10-alpine3.23
ZENDESK_GATEWAY_IMAGE=wordless-zendesk-gateway:pilot
WORDLESS_API_IMAGE=wordless-api:pilot
